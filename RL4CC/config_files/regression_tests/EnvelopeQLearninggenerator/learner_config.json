    "num_train_batches": 1,
    "target_net_update_freq": 1000,
    "tau": 1,
    "num_steps_sampled_before_learning_starts": 100,
    "ref_point": [1.0]
  },
  "exploration": {
    "initial_epsilon": 1.0,
    "final_epsilon": 0.05,
    "epsilon_decay_steps": 50000
  },
  "rollouts": {
    "duration_unit": "timesteps",
    "duration_per_worker": 360
  }
}