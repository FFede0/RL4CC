{
  "training": {
    "grad_clip": 0.1,
    "lr": 3e-4,
    "gamma": 0.98,
    "batch_size": 64,
    "hiddens": [256, 256, 256, 256],
    "replay_buffer_config": {
      "capacity": 2e6
    },
    "initial_homotopy_lambda": 0.0,
